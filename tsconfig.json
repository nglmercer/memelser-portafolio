{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["vite.config.ts", "void.config.ts", "env.ts", "routes/**/*.ts", "crons/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "src/**/*.vue", "verify-*.mts"]
}
